{
  "rulesVersion": 1,
  "handlers": {
    "transcribe": {
      "request": {
        "url": {
          "$url": {
            "base": "config.baseUrl",
            "path": "audio/transcriptions"
          }
        },
        "method": "POST",
        "auth": {
          "type": "bearer",
          "secret": {
            "$secret": "apiKey"
          }
        },
        "bodyType": "multipart",
        "body": {
          "file": {
            "$asset": "input.audio"
          },
          "model": {
            "$ref": "config.model"
          },
          "response_format": "verbose_json",
          "language": {
            "$ref": "input.language",
            "omitIfEmpty": true,
            "omitValues": ["auto"],
            "transform": "languages.toIso6391"
          },
          "timestamp_granularities[]": "segment"
        },
        "responseType": "text"
      },
      "response": {
        "kind": "json",
        "errorPath": "error.message",
        "map": {
          "text": {
            "$ref": "response.text"
          },
          "segments": {
            "$ref": "response.segments"
          }
        }
      }
    }
  }
}
