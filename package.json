{
  "name": "kiss-translator",
  "description": "A minimalist bilingual translation Extension & Greasemonkey Script",
  "version": "2.1.0",
  "author": "Gabe<yugang2002@gmail.com>",
  "private": true,
  "dependencies": {
    "@emotion/cache": "^11.11.0",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@huggingface/transformers": "4.2.0",
    "@mui/icons-material": "^5.15.15",
    "@mui/lab": "5.0.0-alpha.170",
    "@mui/material": "^5.15.15",
    "@paddleocr/paddleocr-js": "0.4.2",
    "@streamparser/json": "^0.0.22",
    "@wllama/wllama": "3.6.1",
    "dompurify": "^3.4.0",
    "fflate": "0.8.3",
    "opencc-js": "1.4.2",
    "phonemizer": "1.2.1",
    "pinyin-pro": "3.29.4",
    "postcss-selector-parser": "6.1.2",
    "query-string": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^8.0.7",
    "react-router-dom": "^6.16.0",
    "react-scripts": "5.0.1",
    "sval": "^0.5.2",
    "webdav": "^5.3.0",
    "webextension-polyfill": "^0.10.0"
  },
  "scripts": {
    "start": "cross-env REACT_APP_CLIENT=web react-app-rewired start",
    "start:userscript": "cross-env REACT_APP_CLIENT=userscript react-app-rewired start",
    "sync-version": "zx src/scripts/sync-version.mjs",
    "version:patch": "zx src/scripts/update-version.mjs patch",
    "version:minor": "zx src/scripts/update-version.mjs minor",
    "version:major": "zx src/scripts/update-version.mjs major",
    "version:set": "zx src/scripts/update-version.mjs set",
    "build:chrome": "zx src/scripts/build-task.mjs --target=chrome",
    "build:chrome:clean": "zx src/scripts/build-task.mjs --target=chrome --rebuild-local-ai",
    "build:local-ai": "node src/scripts/local-ai-cache.mjs",
    "build:edge": "zx src/scripts/build-task.mjs --target=edge",
    "build:safari-output": "zx src/scripts/build-task.mjs --target=safari",
    "build:thunderbird": "zx src/scripts/build-task.mjs --target=thunderbird",
    "build:firefox": "zx src/scripts/build-task.mjs --target=firefox",
    "build:web": "zx src/scripts/build-task.mjs --target=web",
    "build:safari": "node src/scripts/build-safari.mjs",
    "build:userscript-ios": "zx src/scripts/build-ios.mjs",
    "build:rules": "babel-node src/rules.js",
    "format": "prettier --write \"**/*.{js,json,html}\"",
    "build": "pnpm sync-version && pnpm format && pnpm build:chrome && pnpm build:edge && pnpm build:thunderbird && pnpm build:firefox && pnpm build:web && pnpm build:userscript-ios && pnpm build:rules",
    "zip": "zx src/scripts/archive.mjs",
    "build+zip": "cross-env CI=true pnpm build && pnpm zip",
    "test": "react-app-rewired test",
    "test:local-ai": "vitest run src/localAi",
    "test:subtitle-segmentation": "babel-node src/scripts/test-subtitle-segmentation.js",
    "test:terms": "babel-node src/scripts/test-term-replace.js",
    "eject": "react-scripts eject",
    "analyze:chrome": "node src/scripts/bundle-audit.mjs",
    "test:build": "node --test src/scripts/bundle-build.test.mjs",
    "start:homepage": "cross-env REACT_APP_CLIENT=web PORT=3000 BROWSER=none react-app-rewired start",
    "build:homepage": "zx src/scripts/build-task.mjs --target=homepage",
    "build:edge-dev": "zx src/scripts/build-task.mjs --target=edge-dev",
    "debug:edge": "node src/scripts/debug-edge.mjs",
    "test:file-translation-build": "node --test src/scripts/file-translation-build.test.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "globals": {
      "GM": true,
      "unsafeWindow": true,
      "globalThis": true,
      "messenger": true,
      "LanguageDetector": true,
      "Translator": true
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.22.20",
    "@babel/node": "^7.22.19",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.22.20",
    "@types/chrome": "0.0.312",
    "@types/node": "22",
    "@types/react": "18",
    "@types/react-dom": "18",
    "bestzip": "^2.2.1",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.1",
    "find-up": "^7.0.0",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "prettier": "3.6.2",
    "react-app-rewired": "^2.2.1",
    "typescript": "~5.9.3",
    "vite": "6.3.5",
    "vitest": "3.1.3",
    "zx": "^8.8.1"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "4.5.4",
      "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
      "shell-quote": "1.8.4",
      "websocket-driver": "0.7.5"
    }
  }
}
